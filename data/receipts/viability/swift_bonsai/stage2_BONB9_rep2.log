    CAL-U1  unanswerable ABSTAINED         got='UNKNOWN'                          want='UNKNOWN'
    CAL-U2  unanswerable ABSTAINED         got='UNKNOWN'                          want='UNKNOWN'  [6144:length -> 12288:stop]
