# Use Node.js 22 as the base image for latest Fetch API and streaming capabilities
FROM node:22-bullseye-slim

# Install Python 3 and SQLite for the Worker Daemon and Message Bus
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy the Node.js framework dependencies first to leverage Docker caching
COPY engines/open-multi-agent-upstream/package*.json ./engines/open-multi-agent-upstream/
RUN cd engines/open-multi-agent-upstream && npm ci

# Copy the rest of the TSX framework
COPY engines/open-multi-agent-upstream/ ./engines/open-multi-agent-upstream/

# Copy the Python daemon and required modules
COPY modules/ ./modules/
COPY worker_daemon.py .
COPY message_bus_api.py .

# Install Python requirements for the API and MCP
RUN pip3 install --no-cache-dir fastapi uvicorn pydantic mcp

# Create the data directory (even if connecting to a remote API, good practice)
RUN mkdir -p data

# Default Environment Variables (can be overridden via docker run -e)
ENV NODE_NAME="Apollo-Worker-Container"
ENV NODE_ROLE="any"
ENV CONTEXT_WINDOW="32768"
ENV PRECISION_BITS="4.0"
ENV INTERNET_ACCESS="true"
ENV MESSAGE_BUS_API="http://host.docker.internal:8000"

# Enforce Node.js memory limits to prevent V8 crashes on large context processing
ENV NODE_OPTIONS="--max-old-space-size=8192"

# Start the worker daemon
CMD ["python3", "worker_daemon.py"]