# Ignore git and build directories
.git
.github
__pycache__
node_modules
dist
build
coverage
.svelte-kit

# Ignore heavy AI model weights and datasets
*.gguf
*.safetensors
*.bin
*.pt
*.onnx

# Ignore data and logs (mounted via volumes)
data/
logs/
chat_history/
*.log
*.jsonl

# Ignore virtual environments
venv*
.venv
.env

# Aggressive Context Filters for Fast Docker Builds
legacy_vault/
models/
voxtral_rust/
Dev_Log/
vault/
whisper.cpp/
bin/
archive/
*.tar.gz
deploy/apollo-cluster.tar.gz

# Ignore all C++ compiled engines but allow the TSX orchestrator
engines/*
!engines/open-multi-agent-upstream/
